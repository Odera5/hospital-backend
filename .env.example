# Example backend environment variables for local development
# Replace values with your real credentials. If your DATABASE_URL already
# contains query params, append additional params with & instead of ?

# Postgres example with increased Prisma connection pool and timeout
# connection_limit controls max DB connections the Prisma client will open.
# pool_timeout controls how long (seconds) the client will wait for a connection.
DATABASE_URL="postgresql://dbuser:dbpass@localhost:5432/bhf?schema=public&connection_limit=20&pool_timeout=30"

JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
ENCRYPTION_KEY="32_char_minimum_encryption_key_here"

# App / frontend
PORT=5000
APP_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173

# Paystack (optional for local testing)
PAYSTACK_SECRET_KEY=
PAYSTACK_PRO_PLAN_CODE=

# Security & Anti-Bot Protection
# Cloudflare Turnstile secret key (Use 1x0000000000000000000000000000000AA for local/testing always-pass)
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin Notification Email for new clinic alerts
ADMIN_NOTIFICATION_EMAIL=primuxcare@gmail.com

# Stripe (USD Billing for Global / International Clinics)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Pre-created Stripe dashboard Price IDs (if omitted, prices are generated dynamically on checkout: $69/mo, $690/yr, $129/mo, $1,290/yr)
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_PRO_ANNUAL_PRICE_ID=
# STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
# STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=


